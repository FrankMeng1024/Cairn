# Cairn Backend — Environment Variables
# Copy to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# MySQL (required)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=cairn

# JWT — generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex
JWT_EXPIRES_IN=7d

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:8082,http://localhost:19006

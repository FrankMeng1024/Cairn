{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_PLAYWRIGHT_BYPASS": ""
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.yiiling.cn",
        "EXPO_PUBLIC_PLAYWRIGHT_BYPASS": ""
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_PLAYWRIGHT_BYPASS": ""
      }
    },
    "production": {
      "ios": {
        "resourceClass": "m-medium",
        "image": "macos-sequoia-15.5-xcode-26.0"
      },
      "env": {
        "EXPO_PUBLIC_PLAYWRIGHT_BYPASS": ""
      }
    }
  },
  "submit": {
    "production": {}
  }
}

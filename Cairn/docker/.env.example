# ── Database ─────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=change-this-strong-root-password
DB_PASSWORD=change-this-strong-app-password

# ── App secrets ──────────────────────────────────────────────────────────
JWT_SECRET=change-this-jwt-secret-min-32-chars-long-please
CAIRN_TELEMETRY_API_KEY=change-this-telemetry-key-shared-with-app

# ── CORS (comma-separated; include the iPhone IP / TestFlight if needed) ─
CORS_ORIGINS=http://localhost:8082,http://localhost:19006

# ── Optional: Google Sign-In ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
